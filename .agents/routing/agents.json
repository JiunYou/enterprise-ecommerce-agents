      ],
      "review_for": [
        "deployment readiness"
      ],
      "owns": [],
      "model_preference": "Flash"
    }
  ],
  "risk_rules": {
    "source": ".agents/rules/approval-gates.md",
    "high_risk_requires_human_approval": true,
    "routine_requires_human_approval": false
  },
  "review_rules": {
    "QA": [
      "product behavior",
      "executable code",
      "tests",
      "regression",
      "explicit validation"
    ],
    "Security": [
      "auth",
      "authorization",
      "payment",
      "secret",
      "external API/webhook",
      "PII",
      "privileged operation",
      "injection/security-sensitive infrastructure"
    ],
    "Architecture Reviewer": [
      "architecture boundary",
      "cross-module design",
      "dependency boundary",
      "architecture ADR",
      "major domain architecture"
    ],
    "Compliance": [
      "privacy",
      "PII",
      "PCI/regulatory",
      "audit/compliance requirements"
    ],
    "Documentation Reviewer": [
      "durable architecture/governance/API/security documentation requiring independent validation"
    ],
    "Release": [
      "release/deployment readiness"
    ]
  }
}